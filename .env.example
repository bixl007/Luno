# App
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME?schema=public"

# Gemini
BOT_API="YOUR_GEMINI_API_KEY"
GEMINI_MODEL="gemini-3.8-flash"
# Free models tried in order when the chat model is overloaded (503) or out of quota (429). Empty disables failover.
GEMINI_FALLBACK_MODELS="gemini-3.6-flash,gemini-3.5-flash-lite"
# Milliseconds a model may stay silent before the next one starts alongside it (higher saves free-tier requests).
GEMINI_HEDGE_MS="4000"
# Optional: thinking effort for the chat model (low | medium | high)
GEMINI_THINKING_LEVEL="low"

# Small free model that writes short chat titles from the first message.
GEMINI_TITLE_MODEL="gemini-3.1-flash-lite"

# Web search (Google Search grounding via the same Gemini key; free on the 2.5 models; gemini-2.5-flash itself is no longer served to new keys)
GEMINI_SEARCH_MODEL="gemini-2.5-flash-lite"

# Clerk (Frontend + Backend)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxxxxxxxx"
CLERK_SECRET_KEY="sk_test_xxxxxxxxx"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/signin"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/signup"

# Clerk Webhook (for /api/webhooks/clerk)
CLERK_WEBHOOK_SECRET="whsec_xxxxxxxxx"
